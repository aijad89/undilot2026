# Dependencies and build output
/node_modules
/vendor
/public/storage
/storage/*.key
/storage/pail

# Environment. `.env` is per-machine and carries the app key and DB password.
.env
.env.backup
.env.production

# Local-only environment for the Playwright suite. Each machine points it at
# its own copy of the database; see tests/e2e/serve.js for why the suite insists
# on a copy rather than the development database.
.env.e2e

# Test output
/.phpunit.cache
.phpunit.result.cache
/test-results
/playwright-report
/blob-report
/playwright/.cache
/e2e-probe

# Editors and tooling, per-machine
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
/auth.json

# Claude Code writes permission grants into `.local.json` every time anyone
# approves a command, and they carry absolute paths that mean nothing on another
# machine. `.claude/settings.json` stays tracked — that one is shared project
# configuration. Only the per-machine half leaves.
/.claude/settings.local.json

# Participant lists exported from Excel, and anything exported back out of the
# office dump. These carry real names, IC and phone numbers, and git never
# forgets: once pushed, personal data stays in the history even if the file is
# deleted later. Read at run time; never committed.
#
# NOT `/*.csv` — that anchors to the repo root and leaves every subfolder open.
# A folder of exports is exactly how such a file reaches a public remote.
*.csv

# OS noise
.DS_Store
Thumbs.db
*.log

# NOTE: no rule here excludes *.md, on purpose. Every document in this repo is
# tracked — the decisions are the part that is hardest to recover.
/.playwright-mcp
/.impeccable/review/
/.impeccable/questions/
# Two exceptions to the rule above, kept local on purpose: a weekly handover
# note (asked for 2026-10-16) and the to-do list (asked for 2026-11-10).
/last16.10.26.md
/TODO.md

# Dump sistem lama: data peribadi (nama, IC, alamat). Repo ini AWAM.
/kraf_lama.sql
*.sql
!database/**/*.sql

# Scratch SDD: ledger kemajuan, brief tugasan, pakej semakan.
/.superpowers/

# Senarai peserta sebenar dari pejabat: data peribadi. Repo ini AWAM.
/docs/SLIDE SENARAI PEMILIHAN USAHAWAN FKJ 2026.xlsx
# Fail kunci Office semasa dokumen dibuka.
~$*
# Senarai kerja data peribadi (diminta 2026-11-16) — kekal tempatan.
/docs/TO-DO_DataUpdate.md
